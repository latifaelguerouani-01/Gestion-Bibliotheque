<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Auteurs | Verdea</title><link rel="icon" type="image/x-icon" href="${pageContext.request.contextPath}/favicon.ico"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><c:set var="activePage" value="auteurs"/><%@ include file="/WEB-INF/views/partials/sidebar.jsp" %><main class="main-content">
<header class="page-intro"><p class="eyebrow">ADMINISTRATION / CATALOGUE</p><h1>Gestion des auteurs</h1><p>Consultez et gérez les auteurs associés aux ouvrages de Verdea.</p></header>
<c:if test="${not empty erreur}"><div class="alert error"><c:out value="${erreur}"/></div></c:if><c:if test="${param.success eq '1'}"><div class="alert success">Opération effectuée avec succès.</div></c:if>
<c:if test="${sessionScope.role eq 'ADMIN'}"><section class="panel"><h2><c:choose><c:when test="${not empty auteurEdition}">Modifier l'auteur</c:when><c:otherwise>Ajouter un auteur</c:otherwise></c:choose></h2>
<form method="post" action="${pageContext.request.contextPath}/auteurs"><input type="hidden" name="action" value="${not empty auteurEdition ? 'update' : 'add'}"><c:if test="${not empty auteurEdition}"><input type="hidden" name="id" value="${auteurEdition.id}"></c:if><div class="grid"><label>Nom *<input name="nom" required maxlength="100" value="<c:out value='${auteurEdition.nom}'/>" placeholder="Nom de famille"></label><label>Prénom<input name="prenom" maxlength="100" value="<c:out value='${auteurEdition.prenom}'/>" placeholder="Prénom"></label><label class="wide">Biographie<textarea name="biographie" rows="4" placeholder="Quelques informations sur l'auteur"><c:out value="${auteurEdition.biographie}"/></textarea></label></div><div class="form-actions"><button class="btn primary" type="submit">Enregistrer</button><c:if test="${not empty auteurEdition}"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/auteurs">Annuler</a></c:if></div></form></section></c:if>
<section class="panel"><div class="section-head"><div><p class="eyebrow">RÉPERTOIRE</p><h2>Liste des auteurs</h2></div><span class="status-pill">${auteurs.size()} auteur(s)</span></div><div class="table-wrap"><table><thead><tr><th>Nom complet</th><th>Biographie</th><c:if test="${sessionScope.role eq 'ADMIN'}"><th>Actions</th></c:if></tr></thead><tbody><c:forEach items="${auteurs}" var="a"><tr><td><strong><c:out value="${a.prenom}"/> <c:out value="${a.nom}"/></strong></td><td><c:out value="${a.biographie}"/></td><c:if test="${sessionScope.role eq 'ADMIN'}"><td><div class="table-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/auteurs?edit=${a.id}">Modifier</a><form method="post" action="${pageContext.request.contextPath}/auteurs" onsubmit="return confirm('Supprimer cet auteur ?');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${a.id}"><button class="btn btn-danger" type="submit">Supprimer</button></form></div></td></c:if></tr></c:forEach><c:if test="${empty auteurs}"><tr><td colspan="3" class="empty-state">Aucun auteur enregistré.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
