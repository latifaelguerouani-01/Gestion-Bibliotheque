<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Emprunts | Verdea</title><link rel="icon" type="image/x-icon" href="${pageContext.request.contextPath}/favicon.ico"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><c:set var="activePage" value="emprunts"/><%@ include file="/WEB-INF/views/partials/sidebar.jsp" %><main class="main-content"><header class="page-intro"><p class="eyebrow">SUIVI DE LECTURE</p><h1><c:choose><c:when test="${sessionScope.role eq 'ADMIN'}">Gestion des emprunts</c:when><c:otherwise>Mes emprunts</c:otherwise></c:choose></h1><p>Suivez les dates de prêt et les retours prévus de vos ouvrages.</p></header>
<section class="panel"><div class="section-head"><div><p class="eyebrow">HISTORIQUE</p><h2>Liste des emprunts</h2></div><span class="status-pill">${emprunts.size()} emprunt(s)</span></div><div class="table-wrap"><table><thead><tr><c:if test="${sessionScope.role eq 'ADMIN'}"><th>Lecteur</th></c:if><th>Livre</th><th>Date d'emprunt</th><th>Retour prévu</th><th>Retour effectif</th><th>Statut</th></tr></thead><tbody><c:forEach items="${emprunts}" var="e"><tr><c:if test="${sessionScope.role eq 'ADMIN'}"><td><strong><c:out value="${e.utilisateur.prenom}"/> <c:out value="${e.utilisateur.nom}"/></strong></td></c:if><td><strong><c:out value="${e.livre.titre}"/></strong></td><td><c:out value="${e.dateEmprunt}"/></td><td><c:out value="${e.dateRetourPrevue}"/></td><td><c:out value="${e.dateRetourEffective}"/></td><td><c:choose><c:when test="${e.statut eq 'EN_COURS'}"><span class="status-pill">En cours</span></c:when><c:otherwise><span class="availability"><c:out value="${e.statut}"/></span></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty emprunts}"><tr><td colspan="6" class="empty-state">Aucun emprunt à afficher.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
