<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Catalogue | Verdea</title><link rel="icon" type="image/x-icon" href="${pageContext.request.contextPath}/favicon.ico"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><c:set var="activePage" value="livres"/><%@ include file="/WEB-INF/views/partials/sidebar.jsp" %><main class="main-content">
<header class="page-intro"><p class="eyebrow">BIBLIOTHÈQUE NUMÉRIQUE</p><h1>Catalogue des livres</h1><p>Recherchez, explorez et gérez les ouvrages de votre bibliothèque.</p></header>
<div class="page-toolbar"><form class="search-form" method="get" action="${pageContext.request.contextPath}/livres"><input name="q" value="<c:out value='${q}'/>" placeholder="Rechercher par titre, ISBN ou description"><button class="btn primary" type="submit">Rechercher</button></form><span class="status-pill">${livres.size()} livre(s)</span></div>
<c:if test="${not empty erreur}"><div class="alert error"><c:out value="${erreur}"/></div></c:if><c:if test="${param.success eq 'saved'}"><div class="alert success">Livre enregistré avec succès.</div></c:if><c:if test="${param.success eq 'deleted'}"><div class="alert success">Livre supprimé avec succès.</div></c:if><c:if test="${param.success eq 'favorite'}"><div class="alert success">Le livre a été ajouté à vos favoris.</div></c:if>
<c:if test="${param.success eq 'borrowed'}"><div class="alert success">Le livre a été ajouté à votre panier de lecture.</div></c:if>
<c:if test="${param.error eq 'livre.fichier.trop.gros'}"><div class="alert error">Fichier trop volumineux (PDF : 50 Mo maximum, couverture : 5 Mo maximum).</div></c:if>
<c:if test="${param.error eq 'emprunt.livre.indisponible'}"><div class="alert error">Ce livre n'est actuellement pas disponible.</div></c:if>
<c:if test="${param.error eq 'emprunt.deja.en.cours'}"><div class="alert error">Vous avez déjà ce livre dans votre panier de lecture.</div></c:if>
<c:if test="${param.error eq 'emprunt.duree.invalide'}"><div class="alert error">Choisissez une durée comprise entre 1 et 90 jours.</div></c:if>
<c:if test="${param.error eq 'emprunt.pdf.indisponible'}"><div class="alert error">Ce livre ne possède pas encore de fichier PDF accessible.</div></c:if>
<c:if test="${param.error eq 'emprunt.operation.erreur' or param.error eq 'invalid'}"><div class="alert error">Impossible d'effectuer cette opération. Vérifiez les informations et réessayez.</div></c:if>
<c:if test="${sessionScope.role eq 'ADMIN'}"><section class="panel"><h2><c:choose><c:when test="${not empty livreEdition}">Modifier un livre</c:when><c:otherwise>Ajouter un livre</c:otherwise></c:choose></h2><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/livres"><input type="hidden" name="action" value="${not empty livreEdition ? 'update' : 'add'}"><c:if test="${not empty livreEdition}"><input type="hidden" name="id" value="${livreEdition.id}"></c:if><div class="grid">
<label>Titre *<input name="titre" required maxlength="200" value="<c:out value='${livreEdition.titre}'/>" placeholder="Titre du livre"></label><label>ISBN<input name="isbn" maxlength="30" value="<c:out value='${livreEdition.isbn}'/>" placeholder="ISBN"></label><label>Fichier PDF du livre ${empty livreEdition ? '*' : ''}<input type="file" name="pdfFile" accept="application/pdf,.pdf" ${empty livreEdition ? 'required' : ''}><small><c:choose><c:when test="${not empty livreEdition and not empty livreEdition.pdfPath}">PDF actuel conservé si aucun nouveau fichier n'est choisi. </c:when></c:choose>Taille max : 50 Mo.</small></label><label>Image de couverture<input type="file" name="couvertureFile" accept="image/png,image/jpeg,image/gif,image/webp"><small>PNG, JPG, GIF ou WebP (5 Mo max).<c:if test="${not empty livreEdition and not empty livreEdition.couverture}"> Couverture actuelle conservée si aucun fichier n'est choisi.</c:if></small></label><label class="wide">Description<textarea name="description" rows="3" placeholder="Résumé de l'ouvrage"><c:out value="${livreEdition.description}"/></textarea></label><label class="wide">Auteurs<select name="auteurIds" multiple size="4"><c:forEach items="${auteurs}" var="a"><option value="${a.id}"><c:out value="${a.prenom}"/> <c:out value="${a.nom}"/></option></c:forEach></select><small>Maintenez Ctrl pour sélectionner plusieurs auteurs.</small></label><label>Disponibilité<select name="disponible"><option value="true">Disponible</option><option value="false" ${not empty livreEdition and not livreEdition.disponible ? 'selected' : ''}>Indisponible</option></select></label></div><div class="form-actions"><button class="btn primary" type="submit">Enregistrer</button><c:if test="${not empty livreEdition}"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/livres">Annuler</a></c:if></div></form></section></c:if>
<section class="panel"><div class="section-head"><div><p class="eyebrow">COLLECTION VERDEA</p><h2>Liste des ouvrages</h2></div></div><div class="table-wrap"><table><thead><tr><th>Titre</th><th>ISBN</th><th>Auteur(s)</th><th>Disponibilité</th><c:choose><c:when test="${sessionScope.role eq 'ADMIN'}"><th>Actions</th></c:when><c:otherwise><th>Actions</th></c:otherwise></c:choose></tr></thead><tbody><c:forEach items="${livres}" var="l"><tr><td><strong><c:out value="${l.titre}"/></strong><br><small class="muted"><c:out value="${l.description}"/></small></td><td><c:out value="${l.isbn}"/></td><td><c:forEach items="${l.auteurs}" var="a"><c:out value="${a.prenom}"/> <c:out value="${a.nom}"/><br></c:forEach></td><td><c:choose><c:when test="${l.disponible}"><span class="availability">Disponible</span></c:when><c:otherwise><span class="status-pill is-off">Indisponible</span></c:otherwise></c:choose></td><c:choose><c:when test="${sessionScope.role eq 'ADMIN'}"><td><div class="table-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/livres?edit=${l.id}">Modifier</a><form method="post" action="${pageContext.request.contextPath}/livres" onsubmit="return confirm('Supprimer ce livre ?');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${l.id}"><button class="btn btn-danger" type="submit">Supprimer</button></form></div></td></c:when><c:otherwise><td><div class="catalogue-actions">
<form method="post" action="${pageContext.request.contextPath}/favoris"><input type="hidden" name="action" value="add"><input type="hidden" name="livreId" value="${l.id}"><input type="hidden" name="retour" value="catalogue"><button class="btn btn-secondary" type="submit">Ajouter aux favoris</button></form>
<c:choose><c:when test="${l.disponible and not empty l.pdfPath}"><form method="post" action="${pageContext.request.contextPath}/emprunts" class="borrow-inline"><input type="hidden" name="action" value="emprunter"><input type="hidden" name="livreId" value="${l.id}"><input type="hidden" name="retour" value="catalogue"><label class="duration-label">Durée <input type="number" name="duree" min="1" max="90" value="14" required aria-label="Durée de l'emprunt en jours"> jours</label><button class="btn primary" type="submit">Emprunter</button></form></c:when><c:otherwise><span class="status-pill is-off"><c:choose><c:when test="${not l.disponible}">Indisponible</c:when><c:otherwise>PDF non disponible</c:otherwise></c:choose></span></c:otherwise></c:choose>
</div></td></c:otherwise></c:choose></tr></c:forEach><c:if test="${empty livres}"><tr><td colspan="5" class="empty-state">Aucun livre trouvé.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
