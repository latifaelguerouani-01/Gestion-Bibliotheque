<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Catalogue | Verdea</title><link rel="icon" type="image/x-icon" href="${pageContext.request.contextPath}/favicon.ico"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body><div class="app-shell"><c:set var="activePage" value="livres"/><%@ include file="/WEB-INF/views/partials/sidebar.jsp" %><main class="main-content">
<header class="page-intro"><p class="eyebrow">BIBLIOTHÈQUE NUMÉRIQUE</p><h1>Catalogue des livres</h1><p>Recherchez, explorez et gérez les ouvrages de votre bibliothèque.</p></header>
<div class="page-toolbar"><form class="search-form" method="get" action="${pageContext.request.contextPath}/livres"><input name="q" value="<c:out value='${q}'/>" placeholder="Rechercher par titre, ISBN ou description"><button class="btn primary" type="submit">Rechercher</button></form><span class="status-pill">${livres.size()} livre(s)</span></div>
<c:if test="${not empty erreur}"><div class="alert error"><c:out value="${erreur}"/></div></c:if><c:if test="${param.success eq 'saved'}"><div class="alert success">Livre enregistré avec succès.</div></c:if><c:if test="${param.success eq 'deleted'}"><div class="alert success">Livre supprimé avec succès.</div></c:if>
<c:if test="${sessionScope.role eq 'ADMIN'}"><section class="panel"><h2><c:choose><c:when test="${not empty livreEdition}">Modifier un livre</c:when><c:otherwise>Ajouter un livre</c:otherwise></c:choose></h2><form method="post" action="${pageContext.request.contextPath}/livres"><input type="hidden" name="action" value="${not empty livreEdition ? 'update' : 'add'}"><c:if test="${not empty livreEdition}"><input type="hidden" name="id" value="${livreEdition.id}"></c:if><div class="grid">
<label>Titre *<input name="titre" required maxlength="200" value="<c:out value='${livreEdition.titre}'/>" placeholder="Titre du livre"></label><label>ISBN<input name="isbn" maxlength="30" value="<c:out value='${livreEdition.isbn}'/>" placeholder="ISBN"></label><label>Couverture<input name="couverture" value="<c:out value='${livreEdition.couverture}'/>" placeholder="URL ou chemin de couverture"></label><label>Chemin PDF<input name="pdfPath" value="<c:out value='${livreEdition.pdfPath}'/>" placeholder="Chemin du fichier PDF"></label><label class="wide">Description<textarea name="description" rows="3" placeholder="Résumé de l'ouvrage"><c:out value="${livreEdition.description}"/></textarea></label><label class="wide">Auteurs<select name="auteurIds" multiple size="4"><c:forEach items="${auteurs}" var="a"><option value="${a.id}"><c:out value="${a.prenom}"/> <c:out value="${a.nom}"/></option></c:forEach></select><small>Maintenez Ctrl pour sélectionner plusieurs auteurs.</small></label><label>Disponibilité<select name="disponible"><option value="true">Disponible</option><option value="false" ${not empty livreEdition and not livreEdition.disponible ? 'selected' : ''}>Indisponible</option></select></label></div><div class="form-actions"><button class="btn primary" type="submit">Enregistrer</button><c:if test="${not empty livreEdition}"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/livres">Annuler</a></c:if></div></form></section></c:if>
<section class="panel"><div class="section-head"><div><p class="eyebrow">COLLECTION VERDEA</p><h2>Liste des ouvrages</h2></div></div><div class="table-wrap"><table><thead><tr><th>Titre</th><th>ISBN</th><th>Auteur(s)</th><th>Disponibilité</th><c:if test="${sessionScope.role eq 'ADMIN'}"><th>Actions</th></c:if></tr></thead><tbody><c:forEach items="${livres}" var="l"><tr><td><strong><c:out value="${l.titre}"/></strong><br><small class="muted"><c:out value="${l.description}"/></small></td><td><c:out value="${l.isbn}"/></td><td><c:forEach items="${l.auteurs}" var="a"><c:out value="${a.prenom}"/> <c:out value="${a.nom}"/><br></c:forEach></td><td><c:choose><c:when test="${l.disponible}"><span class="availability">Disponible</span></c:when><c:otherwise><span class="status-pill is-off">Indisponible</span></c:otherwise></c:choose></td><c:if test="${sessionScope.role eq 'ADMIN'}"><td><div class="table-actions"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/livres?edit=${l.id}">Modifier</a><form method="post" action="${pageContext.request.contextPath}/livres" onsubmit="return confirm('Supprimer ce livre ?');"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${l.id}"><button class="btn btn-danger" type="submit">Supprimer</button></form></div></td></c:if></tr></c:forEach><c:if test="${empty livres}"><tr><td colspan="5" class="empty-state">Aucun livre trouvé.</td></tr></c:if></tbody></table></div></section></main></div></body></html>
